Store FileZilla's helper-window pointer at full width.

CAsyncSocketEx keeps its helper window's C++ object in the window's user data:
SetWindowLongPtr(hWnd, GWL_USERDATA, (LONG)this), read back with
GetWindowLongPtr. GWL_USERDATA and the LONG cast are the 32-bit forms: on
x86-64 the cast truncates `this`, and the window procedure reading it back
would follow a corrupt pointer (64-bit headers drop GWL_USERDATA precisely so
this cannot compile). GWLP_USERDATA and LONG_PTR are the pointer-sized forms,
present in 32-bit SDKs too, so MSVC and C++Builder builds are unaffected.
Line counts are unchanged.

--- a/source/filezilla/AsyncSocketEx.cpp	2026-10-11 13:30:39.269256666 -0300
+++ b/source/filezilla/AsyncSocketEx.cpp	2026-10-11 13:30:39.285938165 -0300
@@ -60,7 +60,7 @@
 
     m_hWnd=CreateWindow(L"CAsyncSocketEx Helper Window", L"CAsyncSocketEx Helper Window", 0, 0, 0, 0, 0, 0, 0, GetModuleHandle(0), 0);
     DebugAssert(m_hWnd);
-    SetWindowLongPtr(m_hWnd, GWL_USERDATA, (LONG)this);
+    SetWindowLongPtr(m_hWnd, GWLP_USERDATA, (LONG_PTR)this);
   };
 
   virtual ~CAsyncSocketExHelperWindow()
@@ -190,7 +190,7 @@
     DebugAssert(hWnd);
     if (!hWnd)
       return 0;
-    CAsyncSocketExHelperWindow *pWnd=(CAsyncSocketExHelperWindow *)GetWindowLongPtr(hWnd, GWL_USERDATA);
+    CAsyncSocketExHelperWindow *pWnd=(CAsyncSocketExHelperWindow *)GetWindowLongPtr(hWnd, GWLP_USERDATA);
     if (message>=WM_SOCKETEX_NOTIFY)
     {
       DebugAssert(pWnd);
@@ -525,7 +525,7 @@
 
       // Verify parameters
       DebugAssert(hWnd);
-      CAsyncSocketExHelperWindow *pWnd = (CAsyncSocketExHelperWindow *)GetWindowLongPtr(hWnd, GWL_USERDATA);
+      CAsyncSocketExHelperWindow *pWnd = (CAsyncSocketExHelperWindow *)GetWindowLongPtr(hWnd, GWLP_USERDATA);
       DebugAssert(pWnd);
 
       CAsyncSocketEx *pSocket = NULL;
