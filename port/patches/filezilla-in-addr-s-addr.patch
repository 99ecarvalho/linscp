Use in_addr's s_addr in FileZilla's proxy layer.

AsyncProxySocketLayer.cpp reaches the IPv4 address through Winsock's union,
sin_addr.S_un.S_addr. Winsock also defines s_addr as exactly that member
(#define s_addr S_un.S_addr), and s_addr is the name BSD sockets and POSIX
give the field; a POSIX in_addr has no S_un. Same field, so upstream's build
is unchanged. Line counts are unchanged.

--- a/source/filezilla/AsyncProxySocketLayer.cpp	2026-10-11 19:05:36.005990734 -0300
+++ b/source/filezilla/AsyncProxySocketLayer.cpp	2026-10-11 19:05:36.008826998 -0300
@@ -510,7 +510,7 @@
   const SOCKADDR_IN * sockAddr=reinterpret_cast<const SOCKADDR_IN*>(lpSockAddr);
 
   //Save server details
-  m_nProxyPeerIp=sockAddr->sin_addr.S_un.S_addr;
+  m_nProxyPeerIp=sockAddr->sin_addr.s_addr;
   m_nProxyPeerPort=sockAddr->sin_port;
   delete [] m_pProxyPeerHost;
   m_pProxyPeerHost = NULL;
@@ -753,7 +753,7 @@
   {
     LPSOCKADDR_IN addr=reinterpret_cast<LPSOCKADDR_IN>(lpSockAddr);
     addr->sin_port=m_nProxyPeerPort;
-    addr->sin_addr.S_un.S_addr=m_nProxyPeerIp;
+    addr->sin_addr.s_addr=m_nProxyPeerIp;
   }
   return res;
 }
