        "#include \"CustomCommandType.h\""
      ],
      "ranges": [
        {
          "from": "^static UnicodeString __fastcall ExtractExtensionBaseName\\(const UnicodeString & FileName\\)\\s*$",
          "until": "^UnicodeString __fastcall TWinConfiguration::GetProvisionaryExtensionId\\("
        },
        {
          "from": "^__fastcall TCustomCommandType::TCustomCommandType\\(\\) :\\s*$"
        }
      ]
    },
    {
      "output": "windows/LocalCustomCommand.h",
      "source": "source/windows/GUITools.h",
      "transformed": false,
      "prologue": [
        "#pragma once",
        "#include \"CustomCommandsSlice.h\""
      ],
      "from": "^class TLocalCustomCommand : public TFileCustomCommand\\s*$",
      "until": "^namespace Pngimagelist\\s*$"
    },
    {
      "output": "windows/LocalCustomCommand.cpp",
      "source": "source/windows/GUITools.cpp",
      "transformed": false,
