        "#include \"CustomCommandsSlice.h\"",
        "#include \"LocalCustomCommand.h\""
      ],
      "from": "^TLocalCustomCommand::TLocalCustomCommand\\(\\)\\s*$",
      "until": "^typedef std::set<TDataModule \\*> TImagesModules;"
    },
    {
