      "transformed": false,
      "prologue": [
        "#include \"CustomCommandsSlice.h\""
      ],
      "ranges": [
        {
          "from": "^static TShortCut FirstCtrlNumberShortCut = ",
          "until": "^void __fastcall InitializeShortCutCombo\\("
        },
        {
          "from": "^TShortCut __fastcall NormalizeCustomShortCut\\(TShortCut ShortCut\\)\\s*$",
          "until": "^class TMasterPasswordDialog : public TCustomDialog\\s*$"
        }
      ]
    },
    {
      "output": "windows/SynchronizeController.cpp",
      "source": "source/windows/SynchronizeController.cpp",
      "transformed": true,
      "prologue": [
        "#include \"KeepUpToDateSlice.h\""
      ],
      "from": "^#include <RemoteFiles.h>\\s*$"
    },
    {
      "output": "windows/PuttyTools.cpp",
      "source": "source/windows/GUITools.cpp",
      "transformed": true,
      "prologue": [
        "#include \"PuttySlice.h\"",
        "// PuTTY's sessions on POSIX are files the registry export cannot reach: its command line instead (PuttySlice.h).",
        "#if !defined(_WIN32)",
        "#define IsUWP() true",
        "#endif"
      ],
      "from": "^bool __fastcall FindFile\\(UnicodeString & Path\\)\\s*$",
      "until": "^static HWND OperationStatusWindow = 0;",
      "epilogue": [
        "// GUIFinalize's share: the PuTTY sessions' cleanup waited for (PuttySlice.h).",
