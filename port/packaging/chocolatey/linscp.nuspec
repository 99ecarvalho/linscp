<?xml version="1.0" encoding="utf-8"?>
<!-- linscp's Chocolatey package: tools/chocolateyInstall.ps1 downloads and
     runs the release's Inno Setup installer. update.ps1 (chocolatey-au)
     moves the version, URL and checksum to the latest release. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>linscp</id>
    <version>0.7.1</version>
    <title>linscp</title>
    <authors>Eduardo Correia</authors>
    <!-- The chocolatey.org account that pushes the package. -->
    <owners>Apliant</owners>
    <projectUrl>https://linscp.org</projectUrl>
    <projectSourceUrl>https://github.com/99ecarvalho/linscp</projectSourceUrl>
    <packageSourceUrl>https://github.com/99ecarvalho/linscp/tree/main/port/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://linscp.org/manual/</docsUrl>
    <bugTrackerUrl>https://github.com/99ecarvalho/linscp/issues</bugTrackerUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/99ecarvalho/linscp@v0.7.1/assets/app/linscp-256.png</iconUrl>
    <licenseUrl>https://github.com/99ecarvalho/linscp/blob/v0.7.1/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright (c) 2026 Eduardo Correia</copyright>
    <tags>linscp sftp scp ftp ftps webdav s3 ssh file-transfer file-manager sync foss cross-platform</tags>
    <summary>Transfer files to and from servers over SFTP, SCP, FTP/FTPS, WebDAV and S3.</summary>
    <description><![CDATA[linscp transfers files between your computer and remote servers over SFTP, SCP, FTP (with TLS), WebDAV and S3. Its two-panel interface shows local and remote files side by side, with the same sessions, settings and scripting on Linux and Windows.

It synchronizes and compares directories, keeps a remote directory up to date, edits remote files, and runs commands on the server. `linscp-cli` runs the same transfers from scripts.

The package installs linscp for all users with its own installer, silently, with the default tasks: the Explorer "Send to" upload shortcut and the handler for sftp://, scp://, ftp://, ftps://, dav:// and s3:// URLs.
]]></description>
    <releaseNotes>https://github.com/99ecarvalho/linscp/releases/tag/v0.7.1</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
