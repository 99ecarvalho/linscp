<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.linscp.linscp</id>
  <name>linscp</name>
  <summary>SFTP, SCP, FTP, WebDAV and S3 client</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="br.com.apliant">
    <name>Apliant</name>
  </developer>
  <description>
    <p>
      linscp transfers files between your computer and remote servers over
      SFTP, SCP, FTP (with TLS), WebDAV and S3. Its two-panel interface shows
      local and remote files side by side, with the same sessions, settings
      and scripting on Linux and Windows.
    </p>
    <p>
      It synchronizes and compares directories, keeps a remote directory up to
      date, edits remote files, and runs commands on the server.
    </p>
  </description>
